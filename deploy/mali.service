[Unit]
Description=Mali CMMS (ระบบซ่อมบำรุงรถกระเช้าไฟฟ้า)
Documentation=https://github.com/87qwz4xr8d-prog/Mali
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mali
Group=mali
WorkingDirectory=/opt/mali/.next/standalone
EnvironmentFile=/etc/mali.env
Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
ExecStart=/usr/bin/node /opt/mali/.next/standalone/server.js
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
