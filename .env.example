# Mali production / server env
# Copy to `.env` next to docker-compose.yml (or `/etc/mali.env` for systemd).
# Do not commit real secrets.

NODE_ENV=production
PORT=3000
MALI_BIND=0.0.0.0

# Host path mounted into the container at /var/lib/mali (SQLite + uploads)
MALI_DATA_DIR=./data

# Required in production. Generate: openssl rand -hex 32
MALI_SESSION_SECRET=change-me-in-production

# Required on first production boot (empty database). Sets the `admin` password.
# Other first-install seed accounts (tech, engineer, manager, …) keep Mali@2569 until you change them.
MALI_ADMIN_PASSWORD=

# Optional. Override the seed password for non-admin demo users (default Mali@2569).
# MALI_SEED_PASSWORD=

# Set to 1 to show first-install demo logins on the login page (off by default in production).
MALI_SHOW_SEED_LOGINS=0

# Set to 1 when the app is served over HTTPS (session cookie Secure flag).
MALI_HTTPS=0
