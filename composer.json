{
    "name": "company/central-calendar",
    "description": "ปฏิทินกลางบริษัท — พนักงานแต่ละแผนกบันทึกงาน และซิงก์ไป Google Calendar",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "google/apiclient": "^2.18"
    },
    "scripts": {
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
        "serve": "@php -S localhost:8080 -t public public/router.php"
    },
    "extra": {
        "google/apiclient-services": [
            "Calendar"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
